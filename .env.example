# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in ./.data
# DATABASE_URL=postgres://user:password@localhost:5432/kripfresh

# Signs demo session cookies. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Integrations (all optional; demo providers are used when unset)
# GEOCODER_PROVIDER=nominatim        # demo | nominatim
# GEOCODER_CONTACT=ops@example.com   # required by Nominatim usage policy
# ROUTING_PROVIDER=osrm              # demo | osrm
# OSRM_URL=https://router.project-osrm.org
# PAYMENT_PROVIDER=razorpay          # simulated | razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SMS_PROVIDER=                      # console | msg91 | twilio
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
